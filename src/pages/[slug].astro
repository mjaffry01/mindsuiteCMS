---
import Base from '../layouts/Base.astro';

// Every Markdown file in src/content/pages becomes a page at /<file-name>.
// Admins create new pages from the CMS under "Pages".
export async function getStaticPaths() {
  const files = import.meta.glob('../content/pages/*.md', { eager: true }) as Record<string, any>;
  return Object.entries(files).map(([path, mod]) => ({
    params: { slug: path.split('/').pop()!.replace(/\.md$/, '') },
    props: { mod },
  }));
}
const { mod } = Astro.props;
const { Content, frontmatter } = mod;
---
<Base title={`${frontmatter.title} | MindSuite`} description={frontmatter.description}>
  <section class="page-hero">
    <div class="container"><h1 class="reveal">{frontmatter.title}</h1></div>
  </section>
  <section class="section">
    <div class="container prose"><Content /></div>
  </section>
</Base>
