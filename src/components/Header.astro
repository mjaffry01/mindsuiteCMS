---
import site from '../data/site.json';
import { href } from '../lib/url';
---
<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href={href('/')}>
      {site.logo ? <img src={href(site.logo)} alt={site.name} height="32" /> : <><span class="brand-mark" aria-hidden="true"></span><span>{site.name}</span></>}
    </a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu" data-menu-toggle>
      <span></span><span></span><span></span>
    </button>
    <nav id="site-nav" class="site-nav" data-nav>
      {site.nav.map((item) => <a href={href(item.href)}>{item.label}</a>)}
      {site.navCta?.label && <a class="btn btn-primary btn-sm" href={href(site.navCta.href)}>{site.navCta.label}</a>}
    </nav>
  </div>
</header>
